# The single-page app, /api/ → the calibre content server (same origin: no CORS, and the reader can
# fetch book files directly), /state/ → the per-user reading state service in the same pod.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${CALIBRE_API}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        # Book files and covers: stream straight through (Range requests, long transfers).
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
        client_max_body_size 1m;
    }

    # Reading state (server/state.mjs). The sign-in proxy's X-Forwarded-Email header passes
    # through untouched; it is what identifies the user.
    location /state/ {
        proxy_pass http://127.0.0.1:${STATE_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        client_max_body_size 64k;
    }

    # Hashed build output: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /health { return 200 "ok\n"; }

    # Client-side routes.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
